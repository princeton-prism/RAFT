+    def _capture_domain_randomization_state(self, env: CPUMujocoEnv) -> dict:
+        """Capture the current domain randomization state for reproducibility.
+
+        Records the seed, which randomizations were active, and the resulting
+        per-light properties so that the exact visual state can be reproduced
+        or analysed from the saved evaluation results.
+
+        Returns:
+            Dict describing the randomization state. Empty when no
+            randomization was applied.
+        """
+        do_lighting = self.config.task_sampler_config.randomize_lighting
+        do_textures = self.config.task_sampler_config.randomize_textures
+
+        if not do_lighting and not do_textures:
+            return {}
+
+        # Seed that was used to derive the per-randomizer seeds
+        base_seed: int | None = None
+        if self.current_seed is not None:
+            base_seed = self.current_seed + 1
+        state: dict = {
+            "enabled": True,
+            "base_seed": base_seed,
+            "episode_seed": self.current_seed,
+            "randomize_lighting": do_lighting,
+            "randomize_textures": do_textures,
+        }
+
+        # Capture post-randomization lighting properties from the MuJoCo model
+        if do_lighting:
+            model = env.current_model
+            lights = []
+            for i in range(model.nlight):
+                lights.append({
+                    "id": i,
+                    "pos": model.light_pos[i].tolist(),
+                    "dir": model.light_dir[i].tolist(),
+                    "specular": model.light_specular[i].tolist(),
+                    "ambient": model.light_ambient[i].tolist(),
+                    "diffuse": model.light_diffuse[i].tolist(),
+                    "active": int(model.light_active[i]),
+                })
+            state["lighting_seed"] = base_seed
+            state["lights"] = lights
+
+        if do_textures:
+            state["texture_seed"] = (base_seed + 1) if base_seed is not None else None
+
+        return state
